{
  "name": "Find Nuclei Viewer",
  "short_name": "Find Nuclei",
  "description": "View OME-ZARR microscopy images in your browser. Multi-channel fluorescence, HCS plates, segmentation overlays. Your data never leaves your machine.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "theme_color": "#6d28d9",
  "background_color": "#667eea",
  "categories": [
    "productivity",
    "utilities",
    "medical"
  ],
  "icons": [
    {
      "src": "./logo192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./logo512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "OME-Zarr archive",
      "accept": {
        "application/zip": [
          ".ozx"
        ],
        "application/octet-stream": [
          ".ozx"
        ]
      },
      "icons": [
        {
          "src": "./logo192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
