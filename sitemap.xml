<?xml version="1.0" encoding="UTF-8"?>
<!--
  Viewer pages only. The documentation has its own sitemap at /docs/sitemap.xml,
  generated by VitePress on every build, and robots.txt points at both.

  Rewritten 2026-08-16. The previous version was hand-maintained and had gone
  stale: it advertised three URLs under /docs/blog/ that return 404 (the blog
  moved to www.find-nuclei.com) and omitted eleven real documentation pages,
  including analytics-phenotyping, analytics-format and sample-data. A sitemap
  pointing at 404s is read as a neglected site, and the omissions hid the most
  substantial content we have.

  No <lastmod> here on purpose. We do not track when these five pages change,
  and a date that is wrong is worse than one that is absent. The docs sitemap
  carries real dates because VitePress knows them.

  Do not add /docs/ entries to this file. They belong in the generated one, or
  they will drift again.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://find-nuclei.github.io/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://find-nuclei.github.io/demos.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://find-nuclei.github.io/publications.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://find-nuclei.github.io/privacy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://find-nuclei.github.io/terms.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
